# Copy to .env for local runs (.env is git-ignored — never commit real values).
# In GitHub Actions these come from repository Secrets instead.

# Service account email (from the service-account JSON: "client_email").
GOOGLE_CLIENT_EMAIL=my-job-finder@your-project.iam.gserviceaccount.com

# Service account private key (from the JSON: "private_key").
# Keep it on a single line with literal \n sequences, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n...\n-----END PRIVATE KEY-----\n"

# Target spreadsheet.
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_NAME=xing-raw-data
# LinkedIn scraper writes to this tab (linkedin-jobs.spec.ts overrides GOOGLE_SHEET_NAME at runtime).
GOOGLE_SHEET_NAME_LN=ln-raw-data
# Arbeitsagentur scraper writes to this tab (ba-jobs.spec.ts overrides GOOGLE_SHEET_NAME at runtime).
GOOGLE_SHEET_NAME_BA=ba-raw-data

# Z.AI (Zhipu GLM) — used to score each job against profile.md.
ZAI_API_KEY=your-zai-api-key
# Optional Z.AI overrides (defaults shown). Uses the Anthropic-compatible
# coding endpoint (GLM Coding Plan), NOT the pay-as-you-go /paas API.
# ZAI_BASE_URL=https://api.z.ai/api/anthropic
# ZAI_MODEL=glm-4.6

# Matching knobs (defaults shown):
# MATCH_THRESHOLD=0       # 0 = always keep top N by score; set a floor (e.g. 60) to filter
# TOP_N=5                 # keep only the top N matches in the sheet at the end

# Job Tracker API — push the top N matches so they show up in the tracker.
# Leave JOB_TRACKER_API_KEY unset to skip the push.
JOB_TRACKER_API_KEY=your-ingest-api-key
# JOB_TRACKER_API_URL=https://myjobtracker0.netlify.app/api
# JOB_TRACKER_PLATFORM=Xing

# Optional browser overrides (defaults: headed + Google Chrome locally).
# HEADLESS=true
# BROWSER_CHANNEL=        # empty = bundled Chromium
